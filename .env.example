# Keep credentials on the server; never put them in app.js or index.html.
PADLET_API_KEY=
ADMIN_PASSWORD=ADMIN
PORT=8000
HOST=127.0.0.1
# Use a persistent directory, with one Node process per directory.
DATA_DIR=./data
SHEETS_URL=https://script.google.com/macros/s/AKfycbzw9VM7nFSoZmMBFgPe6tWXjMt58GASJJ52rpDk9UpfFkJM8VWYdkQaHCr4uY2SRNm1Kw/exec
# Set the same value in Apps Script Script properties (HANUL_WEBHOOK_SECRET).
SHEETS_TOKEN=
# Set only when running behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false
